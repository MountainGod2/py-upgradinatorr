{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automergeType": "pr",
  "extends": [
    "config:best-practices"
  ],
  "lockFileMaintenance": {
    "automerge": true,
    "enabled": true
  },
  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest"
      ]
    }
  ],
  "pre-commit": {
    "enabled": true
  },
  "registryAliases": {
    "dhi.io": "dhi.io"
  },
  "hostRules": [
    {
      "matchHost": "dhi.io",
      "hostType": "docker",
      "username": "{{ secrets.MEND_DHI_USERNAME }}",
      "password": "{{ secrets.MEND_DHI_PASSWORD }}"
    }
  ]
}