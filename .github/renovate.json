{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automergeType": "pr",
  "extends": [
    "config:best-practices"
  ],
  "lockFileMaintenance": {
    "automerge": true,
    "enabled": true
  },
  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest"
      ]
    }
  ],
  "pre-commit": {
    "enabled": true
  },
  "registryAliases": {
    "dhi.io": "dhi.io"
  }
}
